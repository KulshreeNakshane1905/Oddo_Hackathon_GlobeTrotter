// ============================================================================
// Prisma Schema — GlobalTrotters Database
// ============================================================================
// Defines the full relational schema for the multi-city travel planning app.
// Uses PostgreSQL via Supabase with UUID primary keys throughout.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Users ───────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  password     String   @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  profilePic   String?  @map("profile_pic") @db.Text
  languagePref String   @default("en") @map("language_pref") @db.VarChar(10)
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  trips      Trip[]
  savedCities UserSavedCity[]

  @@map("users")
}

// ── Trips ───────────────────────────────────────────────────────────────────
model Trip {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  tripName      String   @map("trip_name") @db.VarChar(255)
  description   String?  @db.Text
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  coverPhotoUrl String?  @map("cover_photo_url") @db.Text
  isPublic      Boolean  @default(false) @map("is_public")
  shareToken    String?  @unique @map("share_token") @db.VarChar(64)
  dailyBudget   Decimal? @map("daily_budget") @db.Decimal(12, 2)
  currency      String   @default("USD") @db.VarChar(3)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops          Stop[]
  budgetEstimate BudgetEstimate?
  sharedLinks    SharedLink[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("trips")
}

// ── Stops ───────────────────────────────────────────────────────────────────
model Stop {
  id                String   @id @default(uuid()) @db.Uuid
  tripId            String   @map("trip_id") @db.Uuid
  cityId            String   @map("city_id") @db.Uuid
  orderIndex        Int      @map("order_index")
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  notes             String?  @db.Text
  transportCost     Decimal? @map("transport_cost") @db.Decimal(12, 2)
  accommodationCost Decimal? @map("accommodation_cost") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city       City           @relation(fields: [cityId], references: [id])
  activities StopActivity[]

  @@index([tripId, orderIndex])
  @@map("stops")
}

// ── Cities ──────────────────────────────────────────────────────────────────
model City {
  id              String  @id @default(uuid()) @db.Uuid
  name            String  @db.VarChar(255)
  country         String  @db.VarChar(255)
  countryCode     String  @map("country_code") @db.VarChar(3)
  costIndex       Decimal @default(1.0) @map("cost_index") @db.Decimal(5, 2)
  popularityScore Int     @default(0) @map("popularity_score")
  latitude        Float
  longitude       Float
  timezone        String  @db.VarChar(50)
  imageUrl        String? @map("image_url") @db.Text

  // Relations
  stops      Stop[]
  activities Activity[]
  savedBy    UserSavedCity[]

  @@index([countryCode])
  @@map("cities")
}

// ── Activities ──────────────────────────────────────────────────────────────
enum ActivityType {
  SIGHTSEEING
  FOOD
  ADVENTURE
  CULTURE
  NIGHTLIFE
  SHOPPING
  NATURE
  TRANSPORT
  OTHER

  @@map("activity_type")
}

model Activity {
  id            String       @id @default(uuid()) @db.Uuid
  cityId        String?      @map("city_id") @db.Uuid
  name          String       @db.VarChar(255)
  description   String?      @db.Text
  type          ActivityType @default(OTHER)
  avgCost       Decimal      @default(0) @map("avg_cost") @db.Decimal(12, 2)
  durationHours Decimal      @default(1) @map("duration_hours") @db.Decimal(5, 2)
  imageUrl      String?      @map("image_url") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")

  // Relations
  city           City?          @relation(fields: [cityId], references: [id])
  stopActivities StopActivity[]

  @@index([cityId, type])
  @@map("activities")
}

// ── Stop Activities (junction table) ────────────────────────────────────────
model StopActivity {
  id            String   @id @default(uuid()) @db.Uuid
  stopId        String   @map("stop_id") @db.Uuid
  activityId    String   @map("activity_id") @db.Uuid
  scheduledTime DateTime @map("scheduled_time")
  cost          Decimal  @default(0) @db.Decimal(12, 2)
  notes         String?  @db.Text

  // Relations
  stop     Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id])

  @@index([stopId])
  @@map("stop_activities")
}

// ── Budget Estimates ────────────────────────────────────────────────────────
model BudgetEstimate {
  id                 String   @id @default(uuid()) @db.Uuid
  tripId             String   @unique @map("trip_id") @db.Uuid
  totalTransport     Decimal  @default(0) @map("total_transport") @db.Decimal(12, 2)
  totalAccommodation Decimal  @default(0) @map("total_accommodation") @db.Decimal(12, 2)
  totalActivities    Decimal  @default(0) @map("total_activities") @db.Decimal(12, 2)
  totalMeals         Decimal  @default(0) @map("total_meals") @db.Decimal(12, 2)
  totalOther         Decimal  @default(0) @map("total_other") @db.Decimal(12, 2)
  currency           String   @default("USD") @db.VarChar(3)
  calculatedAt       DateTime @default(now()) @map("calculated_at")

  // Relations
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("budget_estimates")
}

// ── Shared Links ────────────────────────────────────────────────────────────
model SharedLink {
  id        String    @id @default(uuid()) @db.Uuid
  tripId    String    @map("trip_id") @db.Uuid
  token     String    @unique @db.VarChar(64)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("shared_links")
}

// ── User Saved Cities ───────────────────────────────────────────────────────
model UserSavedCity {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  cityId String @map("city_id") @db.Uuid

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id])

  @@unique([userId, cityId])
  @@map("user_saved_cities")
}
